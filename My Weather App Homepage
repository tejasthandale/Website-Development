<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Weather App Homepage</title>
    <style>
 *{
    box-sizing: border-box;
    font-family: 'Times New Roman', Times, serif;
 }
 body{
    background-color: skyblue;
    background-image: radial-gradient(circle, white 2px, transparent 3px);
    background-size: 40px 40px ;
    background-repeat: repeat;
    background-position: top center;
    background-attachment: fixed;
    color: white;
    text-align: center;
 }
 .weather-today{
    width: 400px;
    border: 3px solid white;
    border-radius: 20px;
    background-image: linear-gradient(to bottom right, rgb(3, 145, 181), lightblue );
    }
    .cloud-icon{
font-size: 70px;
text-transform: uppercase;
font-style: italic;
font-weight: bold;
animation: CloudFloat 3s infinite alternate;
    }
    @keyframes CloudFloat { from{
        transform: translateY(0);
    }
    to{
        transform: translateY(20px);
    }
}
.temp{
    font-size: 50px;
    font-weight: bolder
}
.details{
    font-size: 20px;
}
.Weekly{
    width: 400px;
    border: 3px solid white;
    border-radius: 20px;
    background-image: linear-gradient(to bottom right, red,yellow);
    background-position: bottom center;
    
    
}
.day{
font-size: 20px;
font-weight: bold
}
    </style>
</head>
<body>
<h1 class="heading">
    My Weather App Homepage
</h1><br>
<h2 class="subtittle">Make Plans for the Weather Ahead</h2>
<div class="weather-today">
    <h2>Today's Weather</h2>
    <div class="cloud-icon">sunny</div>
    <p class="temp">90°F</p>
    <p class="details">City: Frisco</p>
    <p class="details">Condition: Windy</p>
    <p class="details">Humidity: 52%</p>
</div>
<h1>Weather this Week</h1>
<div class="Weekly">
<p class="day">Friday: Sunny-93F</p>
<p class="day">Saturday: Windy-96F</p>
<p class="day">Sunday: Windy-96F</p>
<p class="day">Monday: Windy-96F</p>
<p class="day">Tuesday: Sunny-96F</p>
<p class="day">Wednesday: Sunny-93F</p>
</div>
</body>
</html>
