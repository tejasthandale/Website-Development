<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Box Model</title>
    <style>
        body{
            background-color: darkgreen;
            font-family: Arial, Helvetica, sans-serif;
            color: rgb(214, 13, 13);
            text-align: center;

        }
        .fact-file{
            background-color: lightyellow;
            color: darkslategray;
            width: 300px;
            padding: 25px;
            border: 4px sold forestgreen;
            margin: 30px;
            height: 300px;
        }
        .animal-name{
            color: darkgoldenrod;
            font-size: 35px;
        
        }
        .details{
            color: darkslategray;
            font-size: 20px;
        }
        .Cool-fact{
            color: rgb(71, 105, 12);
            font-style: italic;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="fact-file">
        <h2 class="animal-name">
            Snow Leopard
        </h2>
        <p class="details">
            Big cat
        </p>
        <p class="details">
            Lives in mountains
        </p>
        <p class="details">
            Diet:Deer, Goat, Wild Sheep
        </p>
        <p class="Cool-fact">
            Cool Fact-Can leap up to 15 meters in one jump
        </p>
    </div>
</body>
</html>
