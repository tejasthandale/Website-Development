<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Pet Page </title>
    <style>
        .Top-bar{
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background-color: chocolate;
            color: beige;
            padding: 15px;
        }
        body{
            text-align: center;
            background-color: orange;
            color: white;
            padding: 45px 30px 30px ;

        }
        .item{
            background-color: chocolate;
            border: 2px solid rgb(199, 80, 37);
            padding: 6px 6px;

        }
        .special{
            position: relative;
            background-color: chocolate;
            border: 2px solid rgb(199, 80, 37);
            padding: 6px 6px;
            width: 250px;
            left: 230px;
        }
        .pet-card{
            position: relative;
            border: 2px solid rgb(199, 80, 37);
            background-color: chocolate;
            padding: 6px 6px;
        }
        .badge{
            position: absolute;
            top: 1px;
            right: 1px;
            background-color: green;
            color: lightgreen;
            padding: 4px 8px;
        }
        .scroll{
            position: sticky;
            top: 55px;
            background-color: rgb(11, 143, 214);
            padding: 6px 6px;
            margin: 15px 0px 8px;
            color: darkblue;


        }
    </style>
</head>
<body>
    <div class="Top-bar">
        My Pet Page - Buddy the Labrador
    </div>
    <h1>
        Welcome to my pet page!
    </h1>
   <h2>
    Static
   </h2>
   <div class="item">
    Breed-Labrador
   </div>
   <div class="item"> Age-2 Years</div>
   <h2>Relative</h2>
   <p>
    Does not shift right from its normal spot.
   </p>
   <div class="special">Pet of the Month</div>
   <h2>Absolute</h2>
   <div class="pet-card">
    <p>Buddy is yours</p>
    <div class="badge">adopted</div>
   </div>
   <h2>Sticky</h2>
   <p>Scroll down and locks at the top</p>
   <div class="scroll">More pets available</div>
   <div class="item">Luna the Poodle(1 Year)</div>
   <div class="item">Max the German Shepherd(2 Years)</div>
   <div class="item">Daisy the Beagle(4 Years)</div>
   
</body>
</html>
